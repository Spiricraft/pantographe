def distance_avec_index(x, y, traj):
    M = np.inf
    k = 0
    for i in range(len(traj)):
        d_i = np.sqrt((x - traj[i][0])**2 + (y - traj[i][1])**2)
        if d_i < M:
            M = d_i
            k = i
    return M, traj[k], k


