def direction_correction(x, y, traj, k):
    if k < len(traj) - 1:
        tx = traj[k+1][0] - traj[k][0]
        ty = traj[k+1][1] - traj[k][1]
    else:
        tx = traj[k][0] - traj[k-1][0]
        ty = traj[k][1] - traj[k-1][1]

    norme_t = np.sqrt(tx**2 + ty**2)
    tx /= norme_t
    ty /= norme_t
    nx = traj[k][0] - x
    ny = traj[k][1] - y
    norme_n = np.sqrt(nx**2 + ny**2)
    if norme_n < 1e-10:
        return 0.0, 0.0
    nx /= norme_n
    ny /= norme_n

    return nx, ny





